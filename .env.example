# Copy to .env at the repo root. Never commit .env.

# Compose Postgres (5433 to avoid the local 5432 install). The `neon` database
# holds the fictional seed fixture; keep real work in its own database
# (`CREATE DATABASE neon_real`) so a demo reseed can never touch it.
DATABASE_URL=postgres://neon:neon@localhost:5433/neon

# Loopback by default. There is no authentication, and command checks run shell
# commands: set 0.0.0.0 only if you mean everyone on the network to have both.
NEON_HOST=127.0.0.1
NEON_PORT=4000
NEON_LOG_LEVEL=info

# Auth. `local` is a single-user mode with no sign-in: everything is attributed
# to the user below. `github` arrives with the GitHub App and is not wired yet.
NEON_AUTH_MODE=local
NEON_LOCAL_USER_EMAIL=you@example.com
NEON_LOCAL_USER_NAME=You
NEON_LOCAL_USER_GITHUB_LOGIN=you

# 32-byte key, base64. Encrypts anything in the secrets table (GitHub tokens
# when they exist). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_SECRET_KEY=

# Context assembly. Budget is in tokens and is a hard ceiling: over it, the
# lowest-relevance items are dropped and the pack says so.
NEON_CONTEXT_TOKEN_BUDGET=6000

# Ideas expire silently after this many days untouched.
NEON_IDEA_TTL_DAYS=60
